# Dependency lifecycle scripts do not run on install. A postinstall script committed to
# package.json in May 2026 (825b12a, reverted in a0e9421) would have executed with whatever
# privileges the install had; nothing in this repository's docs build needs one.
ignore-scripts=true

# Refuse to silently reach for a newer version than the lockfile records.
save-exact=false
audit=true
fund=false
