#, python-format
msgid ""
"A backup is created automatically before every save. Restore from "
"%(backups)s if something goes wrong."
msgstr "每次保存前都会自动创建备份。如果出现问题，可从 %(backups)s 恢复。"

msgid "A backup is created automatically before restoring."
msgstr "恢复前会自动创建备份。"

msgid ""
"A backup is taken first and Traefik is restarted afterwards, because it only "
"reads acme.json at startup."
msgstr ""
"会先创建备份，之后重启 Traefik，因为 Traefik 只在启动时读取 acme.json。"

#. Used in the browser
msgid "A bouncer API key cannot read alerts."
msgstr "Bouncer API 密钥无法读取告警。"

#. Used in the browser
#, python-brace-format
msgid ""
"A bouncer API key reads {v1_decisions} and nothing else. {ATK_MACHINE_NOTE}"
