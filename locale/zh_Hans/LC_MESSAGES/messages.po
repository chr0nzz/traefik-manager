msgid_plural "%(label)s: %(num)d events, latest %(message)s"
msgstr[0] "%(label)s：%(num)d 个事件，最新：%(message)s"

#, python-format
msgid ""
"%(line_break)s⚠ A %(buffering)s/%(compress)s middleware is attached - remove "
"it for smooth streaming and seeking."
msgstr ""
"%(line_break)s⚠ 已附加 %(buffering)s/%(compress)s 中间件：移除它可使流式播放"
"和跳转更流畅。"

#, python-format
