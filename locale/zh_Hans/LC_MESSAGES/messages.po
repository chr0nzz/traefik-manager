msgstr "%(child)s 仍被 %(users)s 使用，且仍是 %(parents)s 的后端"

#, python-format
msgid "%(claimed)s already belongs to %(claimed2)s. Pick a different name"
msgstr "%(claimed)s 已属于 %(claimed2)s。选择其他名称"

#, python-format
msgid ""
"%(file)s changed on disk since this editor opened. Reopen it and make the "
"change again."
msgstr "%(file)s 在此编辑器打开后已在磁盘上更改。重新打开它并再次进行更改。"

#, python-format
msgid ""
"%(file)s changed while it was being edited, most likely Traefik renewing a "
"certificate. Nothing was written, try again."
msgstr ""
"%(file)s 在编辑期间被更改，很可能是 Traefik 正在续期证书。未写入任何内容，请"
"重试。"

#, python-format
msgid ""
"%(file)s did not read back as valid JSON after writing, the previous copy "
"was put back"
msgstr "%(file)s 写入后回读的内容不是有效的 JSON，已放回之前的副本"

#, python-format
msgid "%(file)s does not hold a resolver map, nothing was changed"
msgstr "%(file)s 不包含证书解析器映射，未做任何更改"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was changed"
msgstr "%(file)s 在此 Agent 上以只读方式挂载，未做任何更改"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was restored"
msgstr "%(file)s 在此 Agent 上以只读方式挂载，未恢复任何内容"

#, python-format
msgid "%(file)s is mounted read only, nothing was changed"
msgstr "%(file)s 以只读方式挂载，未做任何更改"

#, python-format
msgid "%(file)s is not valid JSON, nothing was changed: %(detail)s"
msgstr "%(file)s 不是有效的 JSON，未做任何更改：%(detail)s"

#, python-format
msgid "%(file)s is not valid UTF-8, nothing was changed"
msgstr "%(file)s 不是有效的 UTF-8，未做任何更改"

#, python-format
msgid ""
"%(file)s was rewritten by something else while it was being saved. Try again."
msgstr "%(file)s 在保存期间被其他程序重写。请重试。"

#, python-format
msgid ""
"%(label)s storage at %(path)s is not writable, so settings, backups and "
"scheduled checks will not survive a restart (%(error)s)"
msgstr ""
"%(label)s 存储 %(path)s 不可写，设置、备份和计划检查在重启后将丢失"
"（%(error)s）"

#, python-format
msgid "%(label)s: %(message)s"
msgstr "%(label)s：%(message)s"

#, python-format
