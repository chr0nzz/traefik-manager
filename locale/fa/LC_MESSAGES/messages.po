msgid "Notifications need {first} and {second}, or clear the step to skip it."
msgstr ""
"اعلان‌ها به {first} و {second} نیاز دارند، یا مرحله را پاک کنید تا از آن "
"صرف‌نظر شود."

#, python-format
msgid ""
"Number of trusted proxies in front of Traefik. It takes the IP that many "
"positions from the right of %(x_forwarded_for)s. One proxy (e.g. "
"Cloudflare only) = %(n1)s."
msgstr ""
"تعداد پراکسی‌های مورد اعتماد جلوی Traefik. IP را از همین تعداد موقعیت از سمت "
"راست %(x_forwarded_for)s برمی‌دارد. یک پراکسی (مثلاً فقط Cloudflare) = %(n1)s."

msgid "OAuth client ID registered at your provider."
msgstr "شناسه کلاینت OAuth ثبت‌شده نزد ارائه‌دهنده شما."

msgid "OIDC / SSO login"
msgstr "ورود OIDC / SSO"

msgid "OIDC Auth (traefik-oidc-auth)"
msgstr "احراز هویت OIDC (traefik-oidc-auth)"

#. Used in the browser
msgid "OIDC enabled"
msgstr "OIDC فعال شد"

msgid ""
"OIDC is enabled but no allowed emails or groups are configured. Ask an "
"admin to set an allowlist."
msgstr ""
"OIDC فعال است اما هیچ ایمیل یا گروه مجازی پیکربندی نشده. از یک مدیر بخواهید "
"فهرست مجاز را تنظیم کند."

msgid "OIDC login failed - no code returned."
msgstr "ورود OIDC ناموفق بود - هیچ کدی برنگشت."

msgid "OIDC login failed - nonce mismatch."
msgstr "ورود OIDC ناموفق بود - nonce مطابقت ندارد."

msgid "OIDC login failed - the provider rejected the token request."
msgstr "ورود OIDC ناموفق بود - ارائه‌دهنده درخواست توکن را رد کرد."

#, python-format
msgid "OIDC login failed - the provider rejected the token request: %(detail)s"
msgstr "ورود OIDC ناموفق بود - ارائه‌دهنده درخواست توکن را رد کرد: %(detail)s"

msgid "OIDC login failed - the provider returned no account details."
msgstr "ورود OIDC ناموفق بود - ارائه‌دهنده هیچ جزئیات حسابی برنگرداند."

msgid "OIDC login failed - the provider returned no id_token."
msgstr "ورود OIDC ناموفق بود - ارائه‌دهنده هیچ id_token برنگرداند."

msgid "OIDC login failed - the provider's id_token could not be verified."
msgstr "ورود OIDC ناموفق بود - id_token ارائه‌دهنده تأیید نشد."

msgid "OIDC login failed - token exchange error."
msgstr "ورود OIDC ناموفق بود - خطا در تبادل توکن."

#, python-format
msgid "OIDC login: %(email)s from %(ip)s"
msgstr "ورود OIDC: %(email)s از %(ip)s"

msgid "OIDC provider unavailable."
msgstr "ارائه‌دهنده OIDC در دسترس نیست."

msgid "OIDC provider unavailable. Try again later."
msgstr "ارائه‌دهنده OIDC در دسترس نیست. بعداً دوباره تلاش کنید."

#. Used in the browser
msgid "OIDC saved"
msgstr "OIDC ذخیره شد"

