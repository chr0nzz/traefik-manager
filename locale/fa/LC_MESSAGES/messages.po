msgid "Passthrough"
msgstr "عبور مستقیم"

#. Used in the browser
msgid "Password"
msgstr "گذرواژه"

msgctxt "heading"
msgid "Password"
msgstr "گذرواژه"

msgctxt "placeholder"
msgid "Password"
msgstr "گذرواژه"

msgctxt "setting"
msgid "Password"
msgstr "گذرواژه"

msgid "Password & 2FA"
msgstr "گذرواژه و 2FA"

#. Used in the browser
msgid ""
"Password must be 72 bytes or fewer, which is the bcrypt limit. Accented "
"and non-Latin characters take more than one byte each."
msgstr ""
"گذرواژه باید 72 بایت یا کمتر باشد که محدودیت bcrypt است. نویسه‌های اعراب‌دار و "
"غیرلاتین هر کدام بیش از یک بایت می‌گیرند."

#. Used in the browser
msgid "Password must be at least 8 characters."
msgstr "گذرواژه باید دست‌کم 8 نویسه باشد."

msgid "Password saved"
msgstr "گذرواژه ذخیره شد"

#. Used in the browser
msgid "Password updated. Every other session was signed out."
msgstr "گذرواژه به‌روزرسانی شد. همه نشست‌های دیگر خارج شدند."

#. Used in the browser
msgid "Passwords do not match."
msgstr "گذرواژه‌ها مطابقت ندارند."

msgid ""
"Paste the middleware body, or a full http:/tcp: block holding a single "
"middleware"
msgstr ""
"بدنه میان‌افزار را جای‌گذاری کنید، یا یک بلوک کامل http:/tcp: که یک میان‌افزار "
"را در بر دارد"

#. Used in the browser
msgid "Paste the static config snippet"
msgstr "قطعه پیکربندی ایستا را جای‌گذاری کنید"

#. Used in the browser
