#, python-format
msgid ""
"%(new_in_v1)s Static Config Editor lets you manage your Traefik static "
"config from the UI. %(set_it_up)s"
msgstr ""
"%(new_in_v1)s l'Editeur de Configuration Statique permet de gérer votre "
"configuration statique Traefik depuis l'interface utilisateur.%(set_it_up)s"

