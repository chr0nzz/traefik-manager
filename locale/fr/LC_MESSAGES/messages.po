#, python-format
msgid ""
"%(file)s changed on disk since this editor opened. Reopen it and make the "
"change again."
msgstr ""
"%(file)s a changé sur le disque depuis la première ouverture. Rouvrez-le et "
"refaites votre modification."

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was changed"
