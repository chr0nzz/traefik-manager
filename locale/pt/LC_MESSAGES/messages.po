#, python-format
msgid ""
"%(file)s changed on disk since this editor opened. Reopen it and make the "
"change again."
msgstr ""
"%(file)s foi alterado no disco depois de este editor ter sido aberto. "
"Reabrir o ficheiro e repetir a alteração."

#, python-format
msgid ""
"%(file)s changed while it was being edited, most likely Traefik renewing a "
"certificate. Nothing was written, try again."
msgstr ""
"%(file)s foi alterado durante a edição, muito provavelmente pelo Traefik a "
"renovar um certificado. Nada foi escrito, tentar novamente."

#, python-format
msgid ""
"%(file)s did not read back as valid JSON after writing, the previous copy "
"was put back"
msgstr ""
"%(file)s não foi lido como JSON válido após a escrita, a cópia anterior foi "
"reposta"

#, python-format
msgid "%(file)s does not hold a resolver map, nothing was changed"
msgstr "%(file)s não contém um mapa de resolvers, nada foi alterado"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was changed"
msgstr "%(file)s está montado só de leitura neste agente, nada foi alterado"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was restored"
msgstr "%(file)s está montado só de leitura neste agente, nada foi restaurado"

#, python-format
