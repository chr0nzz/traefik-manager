msgstr "O Traefik não carregou esta rota"

#. Used in the browser
msgid "Traefik has not reported this router"
msgstr "O Traefik não reportou este router"

#. Used in the browser
msgid "Traefik is not loading any routes through its file provider."
msgstr ""
"O Traefik não está a carregar nenhuma rota através do fornecedor de "
"ficheiros."

#. Used in the browser
msgid ""
"Traefik is restarted afterwards. It only reads acme.json at startup, so "
"without that the change would be undone."
msgstr ""
"O Traefik é reiniciado a seguir. Só lê o acme.json no arranque, por isso, "
"sem isso, a alteração seria desfeita."

#. Used in the browser
msgid "Traefik is running but has loaded nothing from the file provider"
msgstr ""
"O Traefik está em execução, mas não carregou nada do fornecedor de ficheiros"

#. Used in the browser
msgid "Traefik is running with an empty dynamic configuration"
msgstr "O Traefik está em execução com uma configuração dinâmica vazia"

#. Used in the browser
#, python-brace-format
msgid "Traefik log file {leave_empty_for}"
msgstr "Ficheiro de log do Traefik {leave_empty_for}"

#. Used in the browser
#, python-brace-format
msgid "Traefik must be restarted after adding {accesslog} to traefik.yml."
msgstr ""
"É necessário reiniciar o Traefik depois de adicionar {accesslog} ao "
"traefik.yml."

#, python-format
