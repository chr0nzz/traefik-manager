msgstr "%(claimed)s ya pertenece a %(claimed2)s. Elige otro nombre"

#, python-format
msgid ""
"%(file)s changed on disk since this editor opened. Reopen it and make the "
"change again."
msgstr ""
"%(file)s cambió en el disco desde que se abrió este editor. Vuelve a abrirlo "
"y repite el cambio."

#, python-format
msgid ""
"%(file)s changed while it was being edited, most likely Traefik renewing a "
"certificate. Nothing was written, try again."
msgstr ""
"%(file)s cambió mientras se editaba, probablemente porque Traefik renovó un "
"certificado. No se escribió nada, inténtalo de nuevo."

#, python-format
msgid ""
"%(file)s did not read back as valid JSON after writing, the previous copy "
"was put back"
msgstr ""
"%(file)s no se leyó como JSON válido tras escribirlo, se restauró la copia "
"anterior"

#, python-format
msgid "%(file)s does not hold a resolver map, nothing was changed"
msgstr "%(file)s no contiene un mapa de resolvers, no se cambió nada"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was changed"
msgstr ""
"%(file)s está montado en modo de solo lectura en este agente, no se han "
"realizado cambios"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was restored"
msgstr ""
"%(file)s está montado en modo de solo lectura en este agente, no se ha "
"restaurado nada"

#, python-format
msgid "%(file)s is mounted read only, nothing was changed"
msgstr "%(file)s está montado como solo lectura, no se cambió nada"

#, python-format
msgid "%(file)s is not valid JSON, nothing was changed: %(detail)s"
msgstr "%(file)s no es un JSON válido, no se cambió nada: %(detail)s"

#, python-format
msgid "%(file)s is not valid UTF-8, nothing was changed"
msgstr "%(file)s no es UTF-8 válido, no se cambió nada"

#, python-format
msgid ""
"%(file)s was rewritten by something else while it was being saved. Try again."
msgstr ""
"Otro proceso reescribió %(file)s mientras se guardaba. Inténtalo de nuevo."

#, python-format
msgid ""
"%(label)s storage at %(path)s is not writable, so settings, backups and "
"scheduled checks will not survive a restart (%(error)s)"
msgstr ""
"El almacenamiento %(label)s en %(path)s no tiene permisos de escritura, así "
"que los ajustes, las copias de seguridad y las comprobaciones programadas no "
"sobrevivirán a un reinicio (%(error)s)"

