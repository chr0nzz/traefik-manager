#, python-format
msgid ""
"A backend host is required for %(protocol)s routes. Send targetIp (repeated "
"per protocol, index %(index)s) or %(field)s."
msgstr ""
"Se requiere un host de backend para las rutas %(protocol)s. Envía targetIp "
"(repetido por protocolo, índice %(index)s) o %(field)s."

#, python-format
msgid ""
"A backend port is required for %(protocol)s routes. Send targetPort "
"(repeated per protocol, index %(index)s) or %(field)s."
msgstr ""
