#, python-format
msgid "%(claimed)s already belongs to %(claimed2)s. Pick a different name"
msgstr "%(claimed)s gehört bereits zu %(claimed2)s. Wähle einen anderen Namen"

#, python-format
msgid ""
"%(file)s changed on disk since this editor opened. Reopen it and make the "
"change again."
msgstr ""
"%(file)s wurde auf der Festplatte geändert, seit dieser Editor geöffnet "
"wurde. Öffne die Datei erneut und nimm die Änderung noch einmal vor."

#, python-format
msgid ""
"%(file)s changed while it was being edited, most likely Traefik renewing a "
"certificate. Nothing was written, try again."
msgstr ""
"%(file)s wurde während der Bearbeitung geändert, vermutlich hat Traefik ein "
"Zertifikat erneuert. Es wurde nichts geschrieben, versuche es erneut."

#, python-format
msgid ""
"%(file)s did not read back as valid JSON after writing, the previous copy "
"was put back"
msgstr ""
"%(file)s war nach dem Schreiben kein gültiges JSON, die vorherige Kopie "
"wurde wiederhergestellt"

#, python-format
msgid "%(file)s does not hold a resolver map, nothing was changed"
msgstr "%(file)s enthält keine Resolver-Zuordnung, es wurde nichts geändert"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was changed"
msgstr ""
"%(file)s ist auf diesem Agent schreibgeschützt eingebunden, es wurde nichts "
"geändert"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was restored"
msgstr ""
"%(file)s ist auf diesem Agent schreibgeschützt eingebunden, es wurde nichts "
"wiederhergestellt"

#, python-format
msgid "%(file)s is mounted read only, nothing was changed"
msgstr "%(file)s ist schreibgeschützt eingebunden, es wurde nichts geändert"

#, python-format
msgid "%(file)s is not valid JSON, nothing was changed: %(detail)s"
msgstr "%(file)s ist kein gültiges JSON, es wurde nichts geändert: %(detail)s"

#, python-format
msgid "%(file)s is not valid UTF-8, nothing was changed"
msgstr "%(file)s ist kein gültiges UTF-8, es wurde nichts geändert"

#, python-format
msgid ""
"%(file)s was rewritten by something else while it was being saved. Try again."
msgstr ""
"%(file)s wurde während des Speicherns von etwas anderem überschrieben. "
"Versuche es erneut."

#, python-format
msgid ""
"%(label)s storage at %(path)s is not writable, so settings, backups and "
"scheduled checks will not survive a restart (%(error)s)"
msgstr ""
"Speicher für %(label)s unter %(path)s ist nicht beschreibbar, daher "
"überstehen Einstellungen, Backups und geplante Prüfungen keinen Neustart "
"(%(error)s)"

#, python-format
msgid "%(label)s: %(message)s"
msgstr "%(label)s: %(message)s"

