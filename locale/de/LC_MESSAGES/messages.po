msgstr "Traefik"

#. Used in the browser
msgid "Traefik API URL must start with http:// or https://"
msgstr "Die Traefik-API-URL muss mit http:// oder https:// beginnen"

#, python-format
msgid "Traefik API basic auth %(optional)s"
msgstr "Basic Auth für die Traefik-API %(optional)s"

msgid "Traefik API is reachable again"
msgstr "Traefik-API ist wieder erreichbar"

msgid "Traefik API is unreachable"
msgstr "Traefik-API ist nicht erreichbar"

