msgstr[1] "%(label)s: %(num)d Ereignisse, zuletzt %(message)s"

#, python-format
msgid ""
"%(line_break)s⚠ A %(buffering)s/%(compress)s middleware is attached - remove "
"it for smooth streaming and seeking."
msgstr ""
"%(line_break)s⚠ Eine %(buffering)s/%(compress)s-Middleware ist angehängt - "
"entferne sie für flüssiges Streaming und Spulen."

#, python-format
msgid ""
"%(loop)s already routes back to %(name)s, which would make a cycle Traefik "
