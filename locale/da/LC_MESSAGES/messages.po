#, python-format
msgid ""
"A backup is created automatically before every save. Restore from "
"%(backups)s if something goes wrong."
msgstr ""
"Der oprettes automatisk en backup, hver gang der gemmes. Gendan fra "
"%(backups)s, hvis noget går galt."

msgid "A backup is created automatically before restoring."
msgstr "Der oprettes automatisk en backup før gendannelse."

msgid ""
"A backup is taken first and Traefik is restarted afterwards, because it only "
"reads acme.json at startup."
msgstr ""
"Der tages først en backup, og Traefik genstartes bagefter, fordi Traefik kun "
"læser acme.json ved opstart."

#. Used in the browser
msgid "A bouncer API key cannot read alerts."
msgstr "En bouncer-API-nøgle kan ikke læse alerts."

#. Used in the browser
#, python-brace-format
msgid ""
"A bouncer API key reads {v1_decisions} and nothing else. {ATK_MACHINE_NOTE}"
msgstr ""
"En bouncer-API-nøgle læser {v1_decisions} og intet andet. {ATK_MACHINE_NOTE}"

msgid ""
"A convenience list for the route form's host dropdown. It does not change "
"your Traefik config, your TLS, or your routing - domains found in existing "
"routes are picked up automatically, so this is just seeding."
msgstr ""
"En hjælpeliste til værtsrullemenuen i ruteformularen. Den ændrer ikke din "
"Traefik-konfiguration, din TLS eller din routing - domæner fra eksisterende "
"ruter hentes automatisk, så dette er blot et udgangspunkt."

#. Used in the browser
msgid ""
"A copy of acme.json is saved to your backups first, and can be restored from "
"Settings, Backups, Certificates."
msgstr ""
"En kopi af acme.json gemmes først i dine backupper og kan gendannes fra "
"Indstillinger, Backupper, Certifikater."

#. Used in the browser
msgid "A forwardAuth middleware is in use, so this is high priority."
msgstr "En forwardAuth-middleware er i brug, så dette har høj prioritet."

msgid "A label for the device this key belongs to."
msgstr "En etiket for den enhed, som denne nøgle tilhører."

#, python-format
