msgctxt "button"
msgid "Paths"
msgstr "Stier"

#. Used in the browser
#, python-brace-format
msgid ""
"Paths come from alert-level {meta}. No scenario fired, so nothing wrote one. "
"This is a quiet host, not a host that cannot see."
msgstr ""
"Stier kommer fra {meta} på alert-niveau. Intet scenario blev udløst, så "
"intet skrev en. Dette er en rolig host, ikke en host, der ikke kan se."

msgid "Paths matching these patterns skip authentication."
msgstr "Stier, der matcher disse mønstre, springer godkendelse over."

#, python-format
msgid "Paths saved to %(manager_yml)s"
