"%(static_config_path)s env var."
msgstr ""
"Sti til %(traefik_yml)s til fanen %(plugins)s. Lad feltet være tomt for at "
"bruge miljøvariablen %(static_config_path)s."

#, python-format
msgid ""
"Path to Traefik's %(acme_json)s for the %(certificates)s tab. Leave blank to "
"use the %(acme_json_path)s env var."
msgstr ""
"Sti til Traefiks %(acme_json)s til fanen %(certificates)s. Lad feltet være "
"tomt for at bruge miljøvariablen %(acme_json_path)s."

#, python-format
msgid ""
"Path to Traefik's access log for the %(logs)s tab. Leave blank to use the "
"%(access_log_path)s env var."
msgstr ""
"Sti til Traefiks adgangslog til fanen %(logs)s. Lad feltet være tomt for at "
"bruge miljøvariablen %(access_log_path)s."

#. Used in the browser
