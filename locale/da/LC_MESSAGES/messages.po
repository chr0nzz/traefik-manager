#, python-format
msgid ""
"%(file)s changed on disk since this editor opened. Reopen it and make the "
"change again."
msgstr ""
"%(file)s er ændret på disken, siden denne editor blev åbnet. Åbn den igen, "
"og foretag ændringen igen."

#, python-format
msgid ""
"%(file)s changed while it was being edited, most likely Traefik renewing a "
"certificate. Nothing was written, try again."
msgstr ""
"%(file)s blev ændret, mens den blev redigeret, sandsynligvis fordi Traefik "
"fornyede et certifikat. Intet blev skrevet, prøv igen."

#, python-format
msgid ""
"%(file)s did not read back as valid JSON after writing, the previous copy "
"was put back"
msgstr ""
"%(file)s kunne ikke læses som gyldig JSON efter skrivning, den forrige kopi "
"blev lagt tilbage"

#, python-format
msgid "%(file)s does not hold a resolver map, nothing was changed"
msgstr "%(file)s indeholder ingen resolver-tabel, intet blev ændret"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was changed"
msgstr "%(file)s er monteret skrivebeskyttet på denne agent, intet blev ændret"

