msgstr "Obsahuje PUT nebo DELETE"

#. Used in the browser
msgid ""
"Parsed as Traefik's common (CLF) access log. No Host, no TLS, no retry "
"count, no origin timing."
msgstr ""
"Zpracováno jako Traefik access log ve formátu common (CLF). Bez hostu, TLS, "
"počtu opakování a časování originu."

#. Used in the browser
msgid ""
"Parsed as a Traefik JSON access log, so host, scheme, router, retries and "
"nanosecond timing are all available."
msgstr ""
"Zpracováno jako Traefik access log ve formátu JSON, takže host, schéma, "
"router, opakování i časování v nanosekundách jsou k dispozici."

#. Used in the browser
msgid "Parsed as a generic common log. No router, no service, no duration."
msgstr "Zpracováno jako obecný common log. Bez routeru, služby a doby trvání."

