msgstr "Cesta"

msgctxt "setting"
msgid "Path"
msgstr "Cesta"

#, python-format
msgid ""
"Path to %(traefik_yml)s for the %(plugins)s tab. Leave blank to use the "
"%(static_config_path)s env var."
msgstr ""
"Cesta k %(traefik_yml)s pro kartu %(plugins)s. Ponechte prázdné pro použití "
"proměnné prostředí %(static_config_path)s."

#, python-format
msgid ""
"Path to Traefik's %(acme_json)s for the %(certificates)s tab. Leave blank to "
"use the %(acme_json_path)s env var."
msgstr ""
"Cesta k souboru %(acme_json)s Traefiku pro kartu %(certificates)s. Ponechte "
"prázdné pro použití proměnné prostředí %(acme_json_path)s."

#, python-format
msgid ""
"Path to Traefik's access log for the %(logs)s tab. Leave blank to use the "
"%(access_log_path)s env var."
msgstr ""
"Cesta k access logu Traefiku pro kartu %(logs)s. Ponechte prázdné pro "
"použití proměnné prostředí %(access_log_path)s."

#. Used in the browser
msgid "Paths"
msgstr "Cesty"

msgctxt "button"
msgid "Paths"
msgstr "Cesty"

#. Used in the browser
#, python-brace-format
msgid ""
"Paths come from alert-level {meta}. No scenario fired, so nothing wrote one. "
"This is a quiet host, not a host that cannot see."
