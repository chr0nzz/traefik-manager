#. Used in the browser
msgid ""
"Password must be 72 bytes or fewer, which is the bcrypt limit. Accented and "
"non-Latin characters take more than one byte each."
msgstr ""
"Heslo smí mít nejvýše 72 bajtů, což je limit bcrypt. Znaky s diakritikou a "
"nelatinkové znaky zabírají každý více než jeden bajt."

#. Used in the browser
msgid "Password must be at least 8 characters."
msgstr "Heslo musí mít alespoň 8 znaků."

msgid "Password saved"
msgstr "Heslo uloženo"

#. Used in the browser
msgid "Password updated. Every other session was signed out."
msgstr "Heslo aktualizováno. Všechny ostatní relace byly odhlášeny."

#. Used in the browser
msgid "Passwords do not match."
msgstr "Hesla se neshodují."

msgid ""
"Paste the middleware body, or a full http:/tcp: block holding a single "
"middleware"
msgstr "Vložte tělo middleware, nebo celý blok http:/tcp: s jediným middleware"

#. Used in the browser
