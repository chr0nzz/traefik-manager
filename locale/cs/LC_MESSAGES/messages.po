#, python-format
msgid ""
"Number of trusted proxies in front of Traefik. It takes the IP that many "
"positions from the right of %(x_forwarded_for)s. One proxy (e.g. Cloudflare "
"only) = %(n1)s."
msgstr ""
"Počet důvěryhodných proxy před Traefikem. Použije se IP adresa na této "
"pozici zprava v %(x_forwarded_for)s. Jedna proxy (např. pouze Cloudflare) = "
"%(n1)s."

msgid "OAuth client ID registered at your provider."
msgstr "ID OAuth klienta registrované u vašeho poskytovatele."

msgid "OIDC / SSO login"
msgstr "Přihlášení přes OIDC / SSO"

msgid "OIDC Auth (traefik-oidc-auth)"
msgstr "OIDC Auth (traefik-oidc-auth)"

#. Used in the browser
msgid "OIDC enabled"
msgstr "OIDC zapnuto"

msgid ""
"OIDC is enabled but no allowed emails or groups are configured. Ask an admin "
"to set an allowlist."
msgstr ""
"OIDC je zapnuto, ale nejsou nastaveny žádné povolené e-maily ani skupiny. "
"Požádejte správce o nastavení seznamu povolených."

msgid "OIDC login failed - no code returned."
msgstr "Přihlášení přes OIDC se nezdařilo: nebyl vrácen kód."

msgid "OIDC login failed - nonce mismatch."
msgstr "Přihlášení přes OIDC se nezdařilo: nonce nesouhlasí."

msgid "OIDC login failed - the provider rejected the token request."
msgstr ""
"Přihlášení přes OIDC se nezdařilo: poskytovatel odmítl požadavek na token."

#, python-format
msgid "OIDC login failed - the provider rejected the token request: %(detail)s"
msgstr ""
"Přihlášení přes OIDC se nezdařilo: poskytovatel odmítl požadavek na token: "
"%(detail)s"

msgid "OIDC login failed - the provider returned no account details."
msgstr "Přihlášení přes OIDC se nezdařilo: poskytovatel nevrátil údaje o účtu."

msgid "OIDC login failed - the provider returned no id_token."
msgstr "Přihlášení přes OIDC se nezdařilo: poskytovatel nevrátil id_token."

msgid "OIDC login failed - the provider's id_token could not be verified."
msgstr ""
"Přihlášení přes OIDC se nezdařilo: id_token poskytovatele nelze ověřit."

msgid "OIDC login failed - token exchange error."
msgstr "Přihlášení přes OIDC se nezdařilo: chyba výměny tokenu."

#, python-format
msgid "OIDC login: %(email)s from %(ip)s"
msgstr "Přihlášení přes OIDC: %(email)s z %(ip)s"

msgid "OIDC provider unavailable."
msgstr "Poskytovatel OIDC je nedostupný."

msgid "OIDC provider unavailable. Try again later."
msgstr "Poskytovatel OIDC je nedostupný. Zkuste to později."

