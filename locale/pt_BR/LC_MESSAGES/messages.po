"%(file)s changed on disk since this editor opened. Reopen it and make the "
"change again."
msgstr ""
"%(file)s foi alterado no disco desde que este editor foi aberto. Reabra-o e "
"faça a alteração novamente."

#, python-format
msgid ""
"%(file)s changed while it was being edited, most likely Traefik renewing a "
"certificate. Nothing was written, try again."
msgstr ""
"%(file)s foi alterado durante a edição, provavelmente pelo Traefik renovando "
"um certificado. Nada foi gravado, tente novamente."

#, python-format
msgid ""
"%(file)s did not read back as valid JSON after writing, the previous copy "
"was put back"
msgstr ""
"%(file)s não foi lido de volta como JSON válido após a gravação, a cópia "
"anterior foi restaurada"

#, python-format
msgid "%(file)s does not hold a resolver map, nothing was changed"
msgstr "%(file)s não contém um mapa de resolvers, nada foi alterado"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was changed"
msgstr ""
"%(file)s está montado como somente leitura neste agente, nada foi alterado"

#, python-format
