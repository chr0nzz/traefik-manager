msgstr "%(file)s não é UTF-8 válido, nada foi alterado"

#, python-format
msgid ""
"%(file)s was rewritten by something else while it was being saved. Try again."
msgstr ""
"%(file)s foi reescrito por outro processo enquanto era salvo. Tente "
"novamente."

#, python-format
msgid ""
"%(label)s storage at %(path)s is not writable, so settings, backups and "
"scheduled checks will not survive a restart (%(error)s)"
msgstr ""
"O armazenamento %(label)s em %(path)s não é gravável, então as "
"configurações, os backups e as verificações agendadas não sobreviverão a uma "
"reinicialização (%(error)s)"

