"%(file)s changed while it was being edited, most likely Traefik renewing a "
"certificate. Nothing was written, try again."
msgstr ""
"%(file)s a été modifié pendant son édition, très probablement par Traefik "
"lors du renouvellement d’un certificat. Rien n’a été écrit, réessayez."

#, python-format
msgid ""
"%(file)s did not read back as valid JSON after writing, the previous copy "
"was put back"
msgstr ""
"%(file)s n’a pas pu être relu comme un JSON valide après l’écriture, la "
"copie précédente a été restaurée"

#, python-format
msgid "%(file)s does not hold a resolver map, nothing was changed"
msgstr "%(file)s ne contient pas de table de résolveurs, rien n’a été modifié"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was changed"
msgstr ""
"%(file)s est monté en lecture seule sur cet agent, rien n’a été modifié"

#, python-format
