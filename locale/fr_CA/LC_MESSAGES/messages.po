#, python-format
msgid ""
"TLS verification failed - the API certificate is not trusted. Mount your CA "
"into /etc/ssl/certs/ca-certificates.crt or set "
"TRAEFIK_INSECURE_SKIP_VERIFY=true. (%(error)s)"
msgstr ""
"La vérification TLS a échoué : le certificat de l’API n’est pas de "
"confiance. Montez votre certificat CA dans /etc/ssl/certs/ca-"
"certificates.crt ou réglez TRAEFIK_INSECURE_SKIP_VERIFY=true. (%(error)s)"

#, python-format
msgid ""
"TLS verification failed - the agent certificate is not trusted by Traefik "
"Manager (%(error)s)"
msgstr ""
"La vérification TLS a échoué : le certificat de l’agent n’est pas approuvé "
"par Traefik Manager (%(error)s)"

