"Run this command to disable 2FA: %(docker_exec_it)s %(podman_exec_it)s "
"%(flask_reset_password)s"
msgstr ""
"Exécutez cette commande pour désactiver l’authentification à deux facteurs : "
"%(docker_exec_it)s %(podman_exec_it)s %(flask_reset_password)s"

#, python-format
msgid ""
"Run this on %(agent_cli_host_name)s. It installs the %(tm)s CLI and opens "
"its agent installer with the key already set."
msgstr ""
