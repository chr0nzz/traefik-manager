"%(file)s was rewritten by something else while it was being saved. Try again."
msgstr ""
"%(file)s is door iets anders herschreven terwijl het werd opgeslagen. "
"Probeer het opnieuw."

#, python-format
msgid ""
"%(label)s storage at %(path)s is not writable, so settings, backups and "
"scheduled checks will not survive a restart (%(error)s)"
msgstr ""
"Opslag %(label)s op %(path)s is niet beschrijfbaar, dus instellingen, back-"
"ups en geplande controles blijven niet bewaard na een herstart (%(error)s)"

