#, python-format
msgid ""
"%(file)s changed on disk since this editor opened. Reopen it and make the "
"change again."
msgstr ""
"%(file)s is op schijf gewijzigd sinds deze editor werd geopend. Open het "
"opnieuw en breng de wijziging opnieuw aan."

#, python-format
msgid ""
"%(file)s changed while it was being edited, most likely Traefik renewing a "
"certificate. Nothing was written, try again."
msgstr ""
"%(file)s is gewijzigd terwijl het werd bewerkt, waarschijnlijk doordat "
"Traefik een certificaat vernieuwde. Er is niets geschreven, probeer het "
"opnieuw."

#, python-format
msgid ""
"%(file)s did not read back as valid JSON after writing, the previous copy "
"was put back"
msgstr ""
"%(file)s was na het schrijven geen geldige JSON, de vorige kopie is "
"teruggezet"

#, python-format
msgid "%(file)s does not hold a resolver map, nothing was changed"
msgstr "%(file)s bevat geen tabel met resolvers, er is niets gewijzigd"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was changed"
msgstr ""
"%(file)s is alleen-lezen gekoppeld op deze agent, er is niets gewijzigd"

#, python-format
msgid "%(file)s is mounted read only on this agent, nothing was restored"
msgstr "%(file)s is alleen-lezen gekoppeld op deze agent, er is niets hersteld"

#, python-format
msgid "%(file)s is mounted read only, nothing was changed"
msgstr "%(file)s is alleen-lezen gekoppeld, er is niets gewijzigd"

#, python-format
