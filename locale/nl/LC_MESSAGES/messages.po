#, python-format
msgid ""
"A backup is created automatically before every save. Restore from "
"%(backups)s if something goes wrong."
msgstr ""
"Bij elke keer opslaan wordt eerst automatisch een back-up gemaakt. Herstel "
"vanuit %(backups)s als er iets misgaat."

msgid "A backup is created automatically before restoring."
msgstr "Voor het herstellen wordt automatisch een back-up gemaakt."

msgid ""
"A backup is taken first and Traefik is restarted afterwards, because it only "
"reads acme.json at startup."
msgstr ""
"Eerst wordt een back-up gemaakt en daarna wordt Traefik herstart, omdat het "
"acme.json alleen bij het opstarten leest."

#. Used in the browser
msgid "A bouncer API key cannot read alerts."
msgstr "Een bouncer-API-sleutel kan geen alerts lezen."

#. Used in the browser
#, python-brace-format
